{
  "name": "gamified-self-tracker",
  "private": true,
  "workspaces": [
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=e2e-tests"
  }
}
